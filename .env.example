# Copy this file to .env and fill in real values. Never commit your real .env.

# Backend
PORT=5000
NODE_ENV=development

# JWT auth secret for backend token signing/verification
# Use a long random value in real environments.
JWT_SECRET=replace_with_a_long_random_secret

# Postgres connection URL for Drizzle (e.g. Neon, local)
DATABASE_URL=postgres://username:password@host:5432/dbname

# Optional: Gmail configuration (if using Nodemailer for email)
# GMAIL_USER=your_gmail_address@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password_here
# GMAIL_FROM_NAME=EcoVerse Platform

EMAIL=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password
